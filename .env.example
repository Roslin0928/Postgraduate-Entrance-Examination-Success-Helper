# Local development and tests use SQLite. Prisma resolves this path from prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Defaults to fake identity provider locally. Set WECHAT_PROVIDER=wechat only when configured.
WECHAT_PROVIDER=fake
# Set these only in your local .env for the real WeChat provider. Never commit real values.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Local development uses a deterministic fake sentence analyzer.
SENTENCE_ANALYSIS_PROVIDER=fake
# For production set SENTENCE_ANALYSIS_PROVIDER=http and configure:
SENTENCE_ANALYSIS_URL=
SENTENCE_ANALYSIS_API_KEY=
